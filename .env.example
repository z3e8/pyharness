# pyharness — the single config surface. Copy to `.env` (`make setup` does this)
# and fill in ANTHROPIC_API_KEY. `.env` is gitignored; this template is committed.

# === Required ===
ANTHROPIC_API_KEY=

# === Web search (optional) ===
# web.search_results() uses Exa to return a raw ranked list (title/url/snippet)
# to fan out over. web.fetch doesn't need this. Get a key at exa.ai. Held
# parent-side; scrubbed from the agent sandbox like the LLM key.
EXA_API_KEY=

# === Email inbox (optional) — see docs/reference/configuration.md ===
# The read-only `inbox` tool (list/search/read over IMAP). Connection details
# are plain config here; the password (an app password for Gmail/Fastmail/
# iCloud/Outlook) is NOT — store it as the vault secret named `imap`
# (`pyharness-vault set imap`), resolved parent-side and never shown to agent
# code. Point this at a dedicated agent address, not your personal inbox.
# PYHARNESS_IMAP_HOST=imap.fastmail.com
# PYHARNESS_IMAP_PORT=993
# PYHARNESS_IMAP_USER=agent@example.com

# === Session workspace (optional) ===
# By default each run gets a fresh, timestamped session under .sessions/. Set a
# stable path here to reuse one workspace across runs, so files you drop in — and
# files the agent creates — persist between sessions. A path passed on the CLI
# (`uv run pyharness <path>`) overrides this. Relative paths resolve from the repo.
# PYHARNESS_WORKSPACE=.sessions/home

# === Session index & reflection (optional) — see docs/how-to/observability.md ===
# The CLI derives a queryable SQLite index of past sessions (the agent's
# stats()/inspect_session() builtins and its history preamble read it) and runs a
# post-session reflection pass at exit (skill proposals still prompt for
# approval). Both on by default; shown here with their defaults.
# PYHARNESS_INDEX_DB=~/.pyharness/index.db
# PYHARNESS_REFLECT=true

# === Browser login profiles (optional) — see docs/how-to/site-profiles.md ===
# Encrypted, named browser logins (open_browser(profile="x")) so authenticated
# sites survive across sessions. Sealed with the vault passphrase — set that in
# the environment (PYHARNESS_VAULT_PASSPHRASE, deliberately NOT stored here; the
# CLI prompts for it), never in this committed-adjacent file. Override only the
# directory:
# PYHARNESS_PROFILES_DIR=~/.pyharness/profiles

# === Telemetry (app side) — see docs/how-to/observability.md ===
# Off unless enabled here. Sends to the local Phoenix container (`make up`/`make dev`),
# which shows each turn as a trace with per-call cost, tokens, and latency.
PYHARNESS_TELEMETRY_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# plaintext gRPC; local only. Value is read verbatim by the OTel SDK (exact
# "true" match) — keep it on its own line, no trailing inline comment.
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_SERVICE_NAME=pyharness
# set false to redact prompts/code
PYHARNESS_TELEMETRY_CAPTURE_CONTENT=true
# Metrics are off by default: Phoenix is traces-only and per-call cost/tokens are
# on the spans. Set true only with the Langfuse/Prometheus profile (make up-langfuse).
PYHARNESS_TELEMETRY_METRICS=false

# The heavier Langfuse profile (make up-langfuse) reads its own dev defaults from
# docker-compose.langfuse.yml — override those there / via env for non-local use.
