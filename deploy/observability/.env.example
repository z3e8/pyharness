# Copy to `.env` in this directory and edit before any non-local use.
# `docker compose` auto-loads it.

# Auth for the OTel Collector -> Langfuse trace export.
# Create a project in the Langfuse UI (http://localhost:3000), make an API key
# pair, then:  printf 'pk-lf-xxx:sk-lf-xxx' | base64
# and set:  LANGFUSE_OTEL_AUTH=Basic <that-base64>
LANGFUSE_OTEL_AUTH=Basic Y2hhbmdlLW1lOmNoYW5nZS1tZQ==

# --- The values below are baked into docker-compose.yml as dev defaults. ---
# Override them here (and in your secret manager) for anything beyond localhost.
# ENCRYPTION_KEY must be 64 hex chars:  openssl rand -hex 32
# SALT / NEXTAUTH_SECRET:               openssl rand -base64 32
